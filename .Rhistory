fill = factor(node))) +
facet_wrap2(
~ species,
scales = "free_x",
axes = "all",          # draw axis lines/ticks on every panel
remove_labels = "x"    # but strip the text labels except on bottom row
) +
facetted_pos_scales(
x = list(
species == "Meandrina meandrites" ~ scale_x_discrete(labels = c("Oct19", "May22", "Dec22"))
)
) +
geom_sankey(flow.alpha = 0.6, node.color = 'black', flow.color = 'black') +
geom_sankey_label(
aes(
x = as.numeric(x) - 0.2,
label = after_stat(freq)),
size = 7 / .pt, color = "black", fill = "white") +
scale_fill_manual("Condition", values = c(condcolors2)) +
theme(plot.title = element_text(size = 12,hjust = 0.5),
panel.grid.major = element_blank(), panel.grid.minor = element_blank(),
panel.background = element_blank(), axis.line.x = element_line(colour = "black"),
strip.text = element_text(size = 13),
axis.line.y = element_blank(), axis.text.y = element_blank(), axis.ticks.y = element_blank(),
axis.text.x = element_text(colour = "black", angle = 45, hjust = 1, size = 12),
axis.text = element_text(colour = "black"),
axis.title.x = element_blank(),
legend.position = c(0.8,0.8),
legend.title = element_text(size = 12),
legend.text = element_text(size = 12))
sankey
sankey <- ggplot(sankeydf, aes(x = x,
next_x = next_x,
node = node,
next_node = next_node,
fill = factor(node))) +
facet_wrap2(
~ Species,
scales = "free_x",
axes = "all",          # draw axis lines/ticks on every panel
remove_labels = "x"    # but strip the text labels except on bottom row
) +
facetted_pos_scales(
x = list(
Species == "PSTR" ~ scale_x_discrete(labels = c("Oct19", "May22", "Dec22"))
)
) +
geom_sankey(flow.alpha = 0.6, node.color = 'black', flow.color = 'black') +
geom_sankey_label(
aes(
x = as.numeric(x) - 0.2,
label = after_stat(freq)),
size = 7 / .pt, color = "black", fill = "white") +
scale_fill_manual("Condition", values = c(condcolors2)) +
theme(plot.title = element_text(size = 12,hjust = 0.5),
panel.grid.major = element_blank(), panel.grid.minor = element_blank(),
panel.background = element_blank(), axis.line.x = element_line(colour = "black"),
strip.text = element_text(size = 13),
axis.line.y = element_blank(), axis.text.y = element_blank(), axis.ticks.y = element_blank(),
axis.text.x = element_text(colour = "black", angle = 45, hjust = 1, size = 12),
axis.text = element_text(colour = "black"),
axis.title.x = element_blank(),
legend.position = c(0.8,0.8),
legend.title = element_text(size = 12),
legend.text = element_text(size = 12))
sankey
